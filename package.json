{
  "name": "build-ts",
  "version": "0.0.0-semantically-released",
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/build-ts.git"
  },
  "bin": "bin/index.js",
  "files": [
    "bin/",
    "dist/",
    "babel.*",
    "NOTICE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "wb buildIfNeeded --command 'bun run start app'",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "start": "tsx src/index.ts",
    "start-prod": "bun run build && node bin/index.js",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "@babel/core": "8.0.7",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-transform-explicit-resource-management": "8.0.5",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@willbooster/shared-lib-node": "13.8.0",
    "magic-string": "1.4.3",
    "oxc-parser": "0.153.0",
    "rolldown": "1.2.13",
    "signal-exit": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/node-ts": "23.6.4",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/yargs": "17.0.35",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "22.29.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "25.0.9",
    "type-fest": "5.10.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
